{
  "name": "ssh-remote-control-mcp",
  "version": "1.0.0",
  "description": "Remote SSH control MCP server based on the ssh-remote-control skill, exposing connection, execution, upload, and download tools over stdio.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "ssh-remote-control-mcp": "index.js"
  },
  "scripts": {
    "build": "esbuild index.js --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --minify",
    "test": "node test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "ssh",
    "remote-control",
    "sftp",
    "server-management"
  ],
  "license": "MIT",
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "esbuild": "^0.28.1",
    "zod": "^4.2.0"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "express": "^4.19.2",
    "fs-extra": "^11.3.6",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1"
  }
}
