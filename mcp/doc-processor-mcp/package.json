  "description": "Model Context Protocol (MCP) server for document conversion (md_conver) and processing across Word, Excel, PowerPoint, PDF, HTML, and Images.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "doc-processor-mcp": "dist/index.js"
  },
  "files": [
