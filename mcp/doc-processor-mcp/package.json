    "fs-extra": "^11.3.0",
    "mammoth": "^1.9.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdf-to-img": "^7.0.0",
    "pdfkit": "^0.16.0",
    "picomatch": "^4.0.2",
    "pizzip": "^3.1.7",
    "pptxgenjs": "^3.12.0",
    "puppeteer-core": "^25.10.0",
    "sharp": "^0.33.5",
